<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Volunteer Dashboard' }) %>

  <body>
    <%- include('../partials/navbar') %>
      <main class="container donor-dash">

        <div class="dash-welcome-banner">
          <div class="dash-welcome-copy">
            <span class="eyebrow" style="margin-bottom:0.4rem;">Volunteer Portal</span>
            <h1>Welcome, <%= currentUser.name %> 👋</h1>
            <div class="dash-meta-row">
              <% if (currentUser.avgRating> 0) { %>
                <span class="rank-pill" style="background:#fffbeb; border-color:#fde68a; color:#b45309;">⭐ <%=
                    currentUser.avgRating.toFixed(1) %> (<%= currentUser.ratingCount %> ratings)</span>
                <% } %>
                  <span class="pill pill-delivered">✅ <%= currentUser.completedTasks %> Completed Tasks</span>
            </div>
          </div>
          <div class="donor-dash-actions">
            <a href="/volunteer/feedback" class="btn btn-outline">My Rating History</a>
          </div>
        </div>

        <% if (justDelivered) { %>
          <div class="alert alert-success mt-lg">Delivery confirmed and feedback logged. Thank you for your service! 🎉
          </div>
          <% } %>

            <% if (nearbyAlerts.length> 0) { %>
              <% nearbyAlerts.forEach(a=> { %>
                <div class="alert alert-error mt-lg">
                  🚨 <strong>
                    <%= a.title %>
                  </strong> — <%= a.area.address || 'nearby' %>.
                    <% if (a.message) { %>
                      <%= a.message %>
                        <% } %>
                </div>
                <% }) %>
                  <% } %>

                    <div id="live-emergency-banner" class="alert alert-error mt-lg" style="display:none;"></div>
                    <div id="live-task-banner" class="alert alert-success mt-lg" style="display:none; cursor:pointer;"
                      onclick="location.reload()">
                      🔄 A new task was assigned to you — click here to refresh.
                    </div>

                    <div class="section-heading mt-xl mb-md">
                      <h2>My Active Delivery Tasks</h2>
                    </div>

                    <% if (tasks.length===0) { %>
                      <div class="card text-center" style="padding: var(--space-2xl);">
                        <p class="mb-0 muted" style="font-size: var(--fs-body-lg);">No tasks assigned right now. New
                          delivery assignments from NGOs will appear here in real time.</p>
                      </div>
                      <% } else { %>
                        <div class="donation-cards">
                          <% tasks.forEach(t=> { %>
                            <% const d=t.donationId; const request=t.foodRequestId; %>
                              <div class="card task-card">
                                <div class="section-heading" style="margin-bottom: var(--space-xs);">
                                  <strong style="text-transform:capitalize; font-size:1.15rem;">
                                    <%= d && d.type ? d.type : 'Food Donation' %>
                                  </strong>
                                  <span class="pill pill-<%= t.status %>">
                                    <%= t.status.replace(/_/g, ' ') %>
                                  </span>
                                </div>
                                <p class="muted mb-0">
                                  <%= d.quantity %>
                                    <%= d.unit || '' %> · <span class="code-tag">
                                        <%= d.donationCode %>
                                      </span>
                                </p>

                                <dl class="detail-list mt-sm">
                                  <dt>📍 Pickup</dt>
                                  <dd>
                                    <%= t.pickupLocation.address %>
                                  </dd>
                                  <dt>📍 Delivery</dt>
                                  <dd>
                                    <%= t.deliveryLocation.address %>
                                  </dd>
                                  <dt>🕒 Window</dt>
                                  <dd>
                                    <%= new Date(d.timeSlot.date).toLocaleDateString() %>, <%= d.timeSlot.startTime %>–
                                        <%= d.timeSlot.endTime %>
                                  </dd>
                                </dl>

                                <% if (mapsEnabled) { %>
                                  <iframe class="map-embed mt-sm" loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                                    src="https://www.google.com/maps/embed/v1/directions?key=<%= googleMapsApiKey %>&origin=<%= encodeURIComponent(t.pickupLocation.address) %>&destination=<%= encodeURIComponent(t.deliveryLocation.address) %>"></iframe>
                                  <% } %>

                                    <a class="btn btn-outline btn-sm mt-sm" target="_blank" rel="noopener"
                                      href="https://www.google.com/maps/dir/?api=1&origin=<%= encodeURIComponent(t.pickupLocation.address) %>&destination=<%= encodeURIComponent(t.deliveryLocation.address) %>">🗺️
                                      Open in Google Maps</a>

                                    <div class="row-actions mt-md">
                                      <% if (t.status === 'assigned') { %>
                                        <form method="POST" action="/volunteer/tasks/<%= t._id %>/accept" class="inline-form"><button class="btn btn-primary btn-sm">Accept Task</button></form>
                                        <form method="POST" action="/volunteer/tasks/<%= t._id %>/reject" class="inline-form"><button class="btn btn-outline btn-sm">Decline</button></form>
                                      <% } else if (t.status === 'accepted') { %>
                                        <form method="POST" action="/volunteer/tasks/<%= t._id %>/pickup-reached" class="inline-form"><button class="btn btn-primary btn-sm">Reached Pickup</button></form>
                                        <form method="POST" action="/volunteer/tasks/<%= t._id %>/reject" class="inline-form"><button class="btn btn-outline btn-sm">Decline</button></form>
                                      <% } else if (t.status === 'pickup_reached') { %>
                                        <form method="POST" action="/volunteer/tasks/<%= t._id %>/picked" class="inline-form"><button class="btn btn-primary btn-sm">Mark Picked Up</button></form>
                                      <% } else if (t.status === 'picked') { %>
                                        <form method="POST" action="/volunteer/tasks/<%= t._id %>/in-transit" class="inline-form"><button class="btn btn-primary btn-sm">Start Delivery</button></form>
                                      <% } else if (t.status === 'in_transit') { %>
                                        <a href="/volunteer/tasks/<%= t._id %>/deliver" class="btn btn-primary btn-sm">Confirm Delivery</a>
                                      <% } %>
                                    </div>
                              </div>
                              <% }) %>
                        </div>
                        <% } %>

      </main>
      <%- include('../partials/footer') %>

        <style>
          .donor-dash {
            padding: var(--space-xl) 0;
          }

          .dash-welcome-banner {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.94) 0%, rgba(241, 246, 255, 0.96) 100%);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-xl);
            padding: var(--space-xl);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-md);
            flex-wrap: wrap;
            box-shadow: var(--shadow-md);
          }

          .dash-welcome-copy h1 {
            margin-bottom: var(--space-xs);
            font-size: clamp(2rem, 2.4vw, 2.7rem);
          }

          .dash-meta-row {
            display: flex;
            align-items: center;
            gap: var(--space-sm);
            flex-wrap: wrap;
          }

          .rank-pill {
            background: var(--color-surface-alt);
            border: 1px solid var(--color-border);
            padding: 0.3em 0.8em;
            border-radius: var(--radius-full);
            font-size: var(--fs-caption);
            color: var(--color-ink-soft);
            font-weight: 600;
          }

          .donation-cards {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: var(--space-lg);
          }

          .task-card {
            display: flex;
            flex-direction: column;
            background: linear-gradient(180deg, #ffffff 0%, #fffdfc 100%);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: var(--space-lg);
            box-shadow: var(--shadow-sm);
            transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
          }

          .task-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
            border-color: var(--color-primary-light);
          }

          .detail-list {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: var(--space-xs) var(--space-sm);
            margin: 0;
            font-size: var(--fs-body-sm);
            background: var(--color-surface-alt);
            padding: var(--space-sm);
            border-radius: var(--radius-sm);
          }

          .detail-list dt {
            color: var(--color-ink-soft);
            font-weight: 700;
          }

          .detail-list dd {
            margin: 0;
            color: var(--color-ink);
          }

          .row-actions {
            display: flex;
            gap: var(--space-sm);
            flex-wrap: wrap;
            margin-top: auto;
            padding-top: var(--space-sm);
          }

          .code-tag {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            background: var(--color-surface-alt);
            padding: 0.15em 0.5em;
            border-radius: var(--radius-sm);
            border: 1px solid var(--color-border);
          }

          .map-embed {
            width: 100%;
            height: 180px;
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
          }
        </style>
        <script>
          (function () {
            if (!window.aadharSocket) return;

            window.aadharSocket.on('task:new', function () {
              document.getElementById('live-task-banner').style.display = 'block';
            });

            window.aadharSocket.on('emergency:new', function (payload) {
              var banner = document.getElementById('live-emergency-banner');
              banner.textContent = '';
              var strong = document.createElement('strong');
              strong.textContent = '🚨 ' + payload.title;
              banner.appendChild(strong);
              if (payload.address) banner.appendChild(document.createTextNode(' — ' + payload.address));
              if (payload.message) banner.appendChild(document.createTextNode('. ' + payload.message));
              banner.style.display = 'block';
            });
          })();
        </script>
  </body>

</html>