<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — Lions Club' : 'Lions Club — The Soul Serves' %></title>
  <meta name="description" content="Lions Club — The Soul Serves. A community welfare platform connecting volunteers and donors." />
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/tokens.css" />
  <link rel="stylesheet" href="/css/components.css" />
  <% if (typeof extraCss !== 'undefined') { extraCss.forEach(function(href) { %>
    <link rel="stylesheet" href="<%= href %>" />
  <% }) } %>
</head>
