<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Feedback Received' }) %>
<body>
  <%- include('../partials/navbar') %>
  <main class="container list-page">
    <div class="form-page-head">
      <h1>Feedback Received</h1>
      <p class="muted">Ratings and comments left by recipients, relayed through volunteers at delivery.</p>
    </div>

    <% if (feedbackList.length === 0) { %>
      <div class="card text-center">
        <p class="mb-0 muted">No feedback yet. It'll show up here once your donations are delivered and a volunteer logs recipient feedback (Phase 4).</p>
      </div>
    <% } else { %>
      <div class="donation-cards">
        <% feedbackList.forEach(f => { %>
          <div class="card">
            <div class="section-heading" style="margin-bottom: var(--space-xs);">
              <strong style="text-transform:capitalize;"><%= f.donationId.type %> · <%= f.donationId.donationCode %></strong>
              <span class="pill pill-<%= f.category === 'good' ? 'delivered' : (f.category === 'bad' ? 'cancelled' : 'assigned') %>"><%= f.category %></span>
            </div>
            <p class="mb-0"><%= '⭐'.repeat(f.rating) %></p>
            <% if (f.comment) { %><p class="mb-0"><%= f.comment %></p><% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
  <%- include('../partials/footer') %>

  <style>
    .list-page { padding: var(--space-xl) 0; }
    .donation-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-md); }
  </style>
</body>
</html>
