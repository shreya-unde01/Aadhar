<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Add Donation' }) %>
<body>
  <%- include('../partials/navbar') %>
  <main class="container form-page">
    <div class="form-page-head">
      <span class="eyebrow" style="margin-bottom:0.4rem;">New Contribution</span>
      <h1>Add a Donation</h1>
      <p class="muted">Tell us what you're giving and where to pick it up. You'll get a real-time tracking code once submitted.</p>
    </div>

    <% if (errors) { %>
      <div class="alert alert-error">
        <ul style="margin:0; padding-left: 1.1em;">
          <% errors.forEach(e => { %><li><%= e %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <form method="POST" action="/donor/donations" class="card form-card" id="donation-form">
      <div class="field">
        <label>Donation recipient</label>
        <div class="readonly-input">🦁 Lions Club — Community Welfare</div>
      </div>

      <input type="hidden" name="type" value="food">
      <div class="field-row">
        <div class="field">
          <label for="quantity">Quantity</label>
          <input type="number" min="0.01" step="0.01" name="quantity" id="quantity" value="<%= formData.quantity || '' %>" placeholder="e.g. 20" required>
        </div>
        <div class="field">
          <label for="unit">Unit <span class="muted">(optional)</span></label>
          <input type="text" name="unit" id="unit" value="<%= formData.unit || '' %>" placeholder="kg, plates, ₹, items…">
        </div>
      </div>

      <div class="field">
        <label for="description">Description <span class="muted">(optional)</span></label>
        <textarea name="description" id="description" rows="3" placeholder="Special handling, dietary details, or instructions for the volunteer..."><%= formData.description || '' %></textarea>
      </div>

      <div class="field" id="expiry-field" style="display:none;">
        <label for="expiryDate">Expiry Date <span class="muted">(food only)</span></label>
        <input type="date" name="expiryDate" id="expiryDate" value="<%= formData.expiryDate || '' %>">
      </div>

      <hr class="divider">

      <div class="field">
        <label for="address">Pickup Address</label>
        <input type="text" name="address" id="address" value="<%= formData.address || '' %>" placeholder="Full street address for pickup" required>
        <% if (!mapsEnabled) { %>
          <p class="hint">📍 Enter complete address details for seamless pickup coordination.</p>
        <% } else { %>
          <p class="hint">📍 Type to search address, or adjust pin position on the map.</p>
        <% } %>
      </div>
      <input type="hidden" name="lat" id="lat" value="<%= formData.lat || '' %>">
      <input type="hidden" name="lng" id="lng" value="<%= formData.lng || '' %>">
      <% if (mapsEnabled) { %>
        <div id="pickup-map" class="map-picker"></div>
      <% } %>

      <div class="field-row">
        <div class="field">
          <label for="date">Pickup Date</label>
          <input type="date" name="date" id="date" value="<%= formData.date || '' %>" required>
        </div>
        <div class="field">
          <label for="startTime">From</label>
          <input type="time" name="startTime" id="startTime" value="<%= formData.startTime || '' %>" required>
        </div>
        <div class="field">
          <label for="endTime">To</label>
          <input type="time" name="endTime" id="endTime" value="<%= formData.endTime || '' %>" required>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg mt-lg">Submit Donation & Generate Tracking Code</button>
    </form>

    <p class="text-center mt-lg"><a href="/donor/donations/bulk-new" class="btn btn-outline btn-sm">Donating multiple items at once? Use bulk mode →</a></p>
  </main>
  <%- include('../partials/footer') %>

  <style>
    .form-page { padding: var(--space-xl) 0; max-width: 720px; margin: 0 auto; }
    .form-page-head { margin-bottom: var(--space-lg); }
    .form-card { box-shadow: var(--shadow-md); border-radius: var(--radius-lg); padding: var(--space-xl); }
    .readonly-input {
      background: var(--color-surface-alt);
      border: 1px solid var(--color-border);
      padding: 0.8rem 1.1rem;
      border-radius: var(--radius-md);
      font-weight: 700;
      color: var(--color-ink);
      font-size: var(--fs-body-sm);
    }
    .divider { border: none; border-top: 1px solid var(--color-border-subtle); margin: var(--space-lg) 0; }
    .checkbox-field {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: var(--fs-body-sm);
      font-weight: 600;
      margin-top: var(--space-md);
      background: var(--color-surface-alt);
      padding: var(--space-sm) var(--space-md);
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border-subtle);
      cursor: pointer;
    }
    .checkbox-field input { width: 18px; height: 18px; cursor: pointer; accent-color: var(--color-primary); }
    .map-picker { height: 260px; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--color-border); margin-top: var(--space-sm); }
  </style>
  <script>
    const expiryField = document.getElementById('expiry-field');
    if (expiryField) expiryField.style.display = 'block';
  </script>
  <% if (mapsEnabled) { %>
    <script src="/js/maps-picker.js"></script>
    <script>
      window.__initPickupMap = function () {
        initAadharMapPicker({ addressInputId: 'address', latInputId: 'lat', lngInputId: 'lng', mapDivId: 'pickup-map' });
      };
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&libraries=places&callback=__initPickupMap" async defer></script>
  <% } %>
</body>
</html>

