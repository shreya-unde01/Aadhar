<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'AADHAR — The Soul Serves' }) %>
<body>
  <%- include('../partials/navbar') %>

  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Lions Club Community Service</span>
        <h1>Donate food, clothes, and hope. <span class="hero-highlight">Track every step.</span></h1>
        <p class="hero-sub">
          Lions Club connects volunteers and donors so that what you give — a meal, a blanket, an hour of your
          time — actually reaches someone, and you can watch it happen.
        </p>
        <div class="hero-ctas">
          <a href="/signup" class="btn btn-primary btn-lg">Donate Now</a>
          <a href="/signup" class="btn btn-secondary btn-lg">Join as Volunteer</a>
          <a href="/admin/login" class="btn btn-outline btn-lg">Admin Login</a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 420 360" xmlns="http://www.w3.org/2000/svg">
          <!-- dotted journey path: donor -> volunteer -> recipient -->
          <path d="M70,90 C 140,60 180,140 210,170 S 300,230 350,260" fill="none" stroke="var(--color-border)" stroke-width="3" stroke-dasharray="2 14" stroke-linecap="round"/>

          <!-- Donor node -->
          <circle cx="70" cy="90" r="34" fill="var(--color-primary-tint)"/>
          <circle cx="70" cy="90" r="34" fill="none" stroke="var(--color-primary)" stroke-width="2.5"/>
          <text x="70" y="98" text-anchor="middle" font-size="28">🍲</text>
          <text x="70" y="145" text-anchor="middle" font-family="var(--font-body)" font-size="13" font-weight="600" fill="var(--color-ink)">Donor</text>

          <!-- Volunteer node -->
          <circle cx="230" cy="185" r="34" fill="var(--color-secondary-tint)"/>
          <circle cx="230" cy="185" r="34" fill="none" stroke="var(--color-secondary)" stroke-width="2.5"/>
          <text x="230" y="193" text-anchor="middle" font-size="28">🚲</text>
          <text x="230" y="240" text-anchor="middle" font-family="var(--font-body)" font-size="13" font-weight="600" fill="var(--color-ink)">Volunteer</text>

          <!-- Recipient node -->
          <circle cx="355" cy="270" r="34" fill="var(--color-primary-tint)"/>
          <circle cx="355" cy="270" r="34" fill="none" stroke="var(--color-primary)" stroke-width="2.5"/>
          <text x="355" y="278" text-anchor="middle" font-size="28">❤️</text>
          <text x="355" y="325" text-anchor="middle" font-family="var(--font-body)" font-size="13" font-weight="600" fill="var(--color-ink)">Recipient</text>
        </svg>
      </div>
    </div>
  </section>

  <!-- ================= THREE PILLARS ================= -->
  <section class="section">
    <div class="container">
      <div class="pillar-grid">
        <div class="pillar-card">
          <span class="pillar-icon">🍲</span>
          <h3>Donate Food, Save Lives</h3>
          <p>Food, clothes, groceries, medicine, books, money, or your skills — list what you're giving and when it's ready for pickup.</p>
          <a href="/signup" class="pillar-link">Start donating →</a>
        </div>
        <div class="pillar-card">
          <span class="pillar-icon">🚲</span>
          <h3>Become a Volunteer</h3>
          <p>Accept nearby pickups, deliver where it's needed most, and confirm every handoff — your work is what makes the chain real.</p>
          <a href="/signup" class="pillar-link">Join as volunteer →</a>
        </div>
        <div class="pillar-card">
          <span class="pillar-icon">📍</span>
          <h3>Track Impact</h3>
          <p>Every donation gets a tracking code and a visible journey — pending, assigned, picked up, delivered — start to finish.</p>
          <a href="/impact" class="pillar-link">See live impact →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= LIVE STATS ================= -->
  <section class="section stats-section" id="impact-stats">
    <div class="container">
      <div class="section-head">
        <h2>Impact, live from the database</h2>
        <p class="muted">No mockups — these numbers update in real time as deliveries are confirmed.</p>
      </div>
      <div class="stat-grid-public">
        <div class="stat-card-public">
          <span class="stat-value-public" id="stat-meals" data-count-to="<%= stats.mealsDelivered %>">0</span>
          <span class="stat-label-public">Meals Served</span>
        </div>
        <div class="stat-card-public">
          <span class="stat-value-public" id="stat-people" data-count-to="<%= stats.peopleHelpedEstimate %>">0</span>
          <span class="stat-label-public">People Helped <span class="muted" style="font-size:0.7em;">(est.)</span></span>
        </div>
        <div class="stat-card-public">
          <span class="stat-value-public" id="stat-waste" data-count-to="<%= stats.wasteReducedKg %>">0</span>
          <span class="stat-label-public">kg Waste Reduced</span>
        </div>
        <div class="stat-card-public">
          <span class="stat-value-public" id="stat-volunteers" data-count-to="<%= stats.activeVolunteers %>">0</span>
          <span class="stat-label-public">Active Volunteers</span>
        </div>
      </div>
      <p class="text-center mt-lg"><a href="/impact">See the full impact dashboard →</a></p>
    </div>
  </section>

  <!-- ================= TESTIMONIALS ================= -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>What people are saying</h2>
      </div>
      <div class="testimonial-grid">
        <blockquote class="testimonial-card">
          <p>"We used to throw away trays of food after every wedding. Now it's picked up within the hour — someone's actually eating it."</p>
          <footer>— Anjali R., Banquet Hall Owner</footer>
        </blockquote>
        <blockquote class="testimonial-card">
          <p>"I volunteer two evenings a week. Seeing the tracking code go from 'picked up' to 'delivered' after I've dropped something off is oddly satisfying."</p>
          <footer>— Rohit K., Volunteer</footer>
        </blockquote>
        <blockquote class="testimonial-card">
          <p>"Coordinating pickups used to mean a dozen phone calls. Now I assign a volunteer in two clicks and can see exactly where every donation is."</p>
          <footer>— Sr. Fatima, NGO Program Director</footer>
        </blockquote>
      </div>
      <p class="muted text-center" style="font-size: var(--fs-caption);">Illustrative quotes for demonstration purposes.</p>
    </div>
  </section>

  <!-- ================= FINAL CTA + SHARE ================= -->
  <section class="section final-cta">
    <div class="container final-cta-inner">
      <div>
        <h2>Ready to be part of the chain?</h2>
        <p class="muted mb-0">Join Lions Club as a donor or volunteer.</p>
      </div>
      <div class="hero-ctas">
        <a href="/signup" class="btn btn-primary btn-lg">Get Started</a>
      </div>
    </div>
    <div class="container share-row">
      <span class="muted" style="font-size: var(--fs-body-sm);">Share AADHAR:</span>
      <a class="share-btn" target="_blank" rel="noopener" href="https://wa.me/?text=Check%20out%20AADHAR%20%E2%80%94%20a%20platform%20connecting%20NGOs%2C%20volunteers%2C%20and%20donors">WhatsApp</a>
      <a class="share-btn" target="_blank" rel="noopener" href="https://twitter.com/intent/tweet?text=Check%20out%20AADHAR%20%E2%80%94%20a%20platform%20connecting%20NGOs%2C%20volunteers%2C%20and%20donors">X / Twitter</a>
      <a class="share-btn" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Faadhar.example.org">Facebook</a>
      <button class="share-btn" id="copy-link-btn" type="button">Copy Link</button>
    </div>
  </section>

  <%- include('../partials/footer') %>

  <style>
    .hero { background: linear-gradient(180deg, var(--color-surface-alt), var(--color-bg)); overflow: hidden; }
    .hero-inner { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: var(--space-xl); padding: var(--space-2xl) 0; }
    .eyebrow { display: inline-block; font-size: var(--fs-caption); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-primary-dark); background: var(--color-primary-tint); padding: 0.3em 0.9em; border-radius: var(--radius-full); margin-bottom: var(--space-md); }
    .hero-copy h1 { font-size: var(--fs-display-xl); max-width: 15ch; }
    .hero-highlight { color: var(--color-primary); }
    .hero-sub { font-size: var(--fs-body-lg); max-width: 46ch; }
    .hero-ctas { display: flex; gap: var(--space-sm); flex-wrap: wrap; margin-top: var(--space-lg); }
    .btn-lg { padding: 0.85em 1.6em; font-size: var(--fs-body); }
    .btn-secondary { background: var(--color-secondary); color: #fff; }
    .btn-secondary:hover { background: var(--color-secondary-dark); }
    .hero-art svg { width: 100%; height: auto; }

    .section { padding: var(--space-2xl) 0; }
    .section-head { max-width: 60ch; margin-bottom: var(--space-lg); }

    .pillar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); }
    .pillar-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-lg); transition: box-shadow var(--transition-base), transform var(--transition-base); }
    .pillar-card:hover { box-shadow: var(--shadow-md); transform: translateY(-4px); }
    .pillar-icon { font-size: 2.2rem; display: block; margin-bottom: var(--space-sm); }
    .pillar-link { font-weight: 700; }

    .stats-section { background: var(--color-surface-alt); border-radius: var(--radius-lg); margin: 0 var(--space-lg); }
    .stat-grid-public { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); }
    .stat-card-public { background: var(--color-surface); border-radius: var(--radius-lg); padding: var(--space-lg); text-align: center; box-shadow: var(--shadow-sm); }
    .stat-value-public { display: block; font-family: var(--font-display); font-size: var(--fs-display-lg); font-weight: 700; color: var(--color-primary); }
    .stat-label-public { color: var(--color-ink-soft); font-weight: 600; font-size: var(--fs-body-sm); }

    .testimonial-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); }
    .testimonial-card { background: var(--color-surface); border-left: 4px solid var(--color-primary); border-radius: var(--radius-md); padding: var(--space-lg); margin: 0; }
    .testimonial-card p { color: var(--color-ink); font-style: italic; }
    .testimonial-card footer { font-size: var(--fs-body-sm); font-weight: 700; color: var(--color-ink-soft); }

    .final-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-lg); flex-wrap: wrap; background: var(--color-secondary-tint); border-radius: var(--radius-lg); padding: var(--space-xl); }
    .share-row { display: flex; align-items: center; gap: var(--space-sm); flex-wrap: wrap; margin-top: var(--space-lg); }
    .share-btn { border: 1.5px solid var(--color-border); border-radius: var(--radius-full); padding: 0.4em 1em; font-size: var(--fs-body-sm); font-weight: 600; color: var(--color-ink); background: var(--color-surface); cursor: pointer; }
    .share-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }

    @media (max-width: 900px) {
      .hero-inner { grid-template-columns: 1fr; }
      .hero-art { order: -1; max-width: 280px; margin: 0 auto; }
      .pillar-grid, .testimonial-grid { grid-template-columns: 1fr; }
      .stat-grid-public { grid-template-columns: repeat(2, 1fr); }
      .stats-section { margin: 0 var(--space-sm); }
    }
  </style>
  <script src="/js/counter-animate.js"></script>
  <script>
    (function () {
      var copyBtn = document.getElementById('copy-link-btn');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          navigator.clipboard.writeText(window.location.origin).then(function () {
            copyBtn.textContent = 'Copied!';
            setTimeout(function () { copyBtn.textContent = 'Copy Link'; }, 1500);
          });
        });
      }

      if (window.aadharSocket) {
        window.aadharSocket.on('impact:update', function (payload) {
          var mealsEl = document.getElementById('stat-meals');
          var peopleEl = document.getElementById('stat-people');
          var wasteEl = document.getElementById('stat-waste');
          if (payload.type === 'food') {
            if (mealsEl) window.AadharCounters.bump(mealsEl, payload.quantity);
            if (wasteEl) window.AadharCounters.bump(wasteEl, payload.quantity);
          }
          if (peopleEl) window.AadharCounters.bump(peopleEl, 3); // matches server-side estimate multiplier
        });
      }
    })();
  </script>
</body>
</html>
