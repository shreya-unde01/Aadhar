<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { title: 'Manage Donations' }) %>
<body>
  <%- include('../partials/navbar') %>
  <main class="container list-page">
    <div class="form-page-head">
      <h1>Manage Donations</h1>
      <p class="muted">All donations across every donor. Assign volunteers, flag urgent items, and track progress.</p>
    </div>

    <div id="live-banner" class="alert alert-success" style="display:none; cursor:pointer;" onclick="location.reload()">
      🔄 A donation was added or updated — click to refresh.
    </div>

    <div class="filter-tabs">
      <a href="/admin/donations" class="filter-tab <%= !query.status ? 'active' : '' %>">All</a>
      <% statuses.forEach(s => { %>
        <a href="/admin/donations?status=<%= s %>" class="filter-tab <%= query.status === s ? 'active' : '' %>" style="text-transform:capitalize;"><%= s %></a>
      <% }) %>
      <a href="/admin/donations?urgent=1" class="filter-tab <%= query.urgent === '1' ? 'active' : '' %>" style="color: var(--color-danger);">🚨 Urgent</a>
    </div>

    <% if (donations.length === 0) { %>
      <div class="card text-center"><p class="mb-0 muted">No donations match this filter.</p></div>
    <% } else { %>
      <div class="card" style="padding:0; overflow-x:auto;">
        <table class="lb-table">
          <thead>
            <tr><th>Code</th><th>Donor</th><th>Type</th><th>Qty</th><th>Status</th><th>Urgent</th><th>Pickup</th><th></th></tr>
          </thead>
          <tbody>
            <% donations.forEach(d => { %>
              <tr>
                <td><%= d.donationCode %></td>
                <td><%= d.donorId ? d.donorId.name : '—' %></td>
                <td style="text-transform:capitalize;"><%= d.type %></td>
                <td><%= d.quantity %> <%= d.unit || '' %></td>
                <td><span class="pill pill-<%= d.status %>"><%= d.status %></span></td>
                <td>
                  <form method="POST" action="/admin/donations/<%= d._id %>/toggle-urgent" class="inline-form">
                    <button type="submit" class="btn btn-sm <%= d.urgent ? 'btn-primary' : 'btn-outline' %>"><%= d.urgent ? '🚨 Urgent' : 'Mark urgent' %></button>
                  </form>
                </td>
                <td class="muted"><%= new Date(d.timeSlot.date).toLocaleDateString() %></td>
                <td>
                  <% if (d.status === 'pending') { %>
                    <a href="/admin/donations/<%= d._id %>/assign" class="btn btn-primary btn-sm">Assign</a>
                  <% } else { %>
                    <a href="/admin/donations/<%= d._id %>/assign" class="btn btn-outline btn-sm">View</a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
  <%- include('../partials/footer') %>

  <style>
    .list-page { padding: var(--space-xl) 0; }
    .filter-tabs { display: flex; gap: var(--space-xs); flex-wrap: wrap; margin-bottom: var(--space-lg); }
    .filter-tab { padding: 0.4em 1em; border-radius: var(--radius-full); border: 1.5px solid var(--color-border); font-size: var(--fs-body-sm); font-weight: 600; color: var(--color-ink-soft); }
    .filter-tab.active, .filter-tab:hover { border-color: var(--color-primary); color: var(--color-primary); background: var(--color-primary-tint); }
    .lb-table { width: 100%; border-collapse: collapse; white-space: nowrap; }
    .lb-table th, .lb-table td { padding: var(--space-sm) var(--space-md); text-align: left; font-size: var(--fs-body-sm); }
    .lb-table thead { background: var(--color-surface-alt); }
    .lb-table tbody tr { border-top: 1px solid var(--color-border); }
  </style>
  <script>
    if (window.aadharSocket) {
      var showBanner = function () { document.getElementById('live-banner').style.display = 'block'; };
      window.aadharSocket.on('donation:new', showBanner);
      window.aadharSocket.on('donation:status', showBanner);
    }
  </script>
</body>
</html>
